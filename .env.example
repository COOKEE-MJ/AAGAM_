# Copy to .env. NEVER commit .env (it is in .gitignore).
PORT=3000
DATABASE_URL=postgres://shield:shield@localhost:5432/aagam
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Mock-first switches (see README "Mocked parts")
# AI_MODE=mock returns a fake verify result until M3's service is live.
# AI_MODE=live proxies to VISION_URL (M3's POST /verify-image).
AI_MODE=mock
VISION_URL=http://localhost:8000/verify-image
# Confidence at or above this + matching label = ai_verified (proposal, tune with M3)
AI_THRESHOLD=0.70

# Guests may send SOS while the demo is being built. Set false to require citizen login.
ALLOW_GUEST_SOS=true

# Demo SMS gateway: always mocked (writes to sms_log table, sends nothing)
SMS_MODE=mock

# Used only by scripts/smoke-test.js
SMOKE_BASE_URL=http://localhost:3000

# Shared secret so M3's radar can POST /api/alerts without an officer login (send header X-Radar-Key)
RADAR_API_KEY=change-me-radar-key
